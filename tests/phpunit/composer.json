{
    "name": "azizulhasan/text-to-audio-tests",
    "description": "Test and lint tools for the plugin. Kept apart from the plugin's own composer.json so nothing here can reach the release ZIP.",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "wp-coding-standards/wpcs": "^3.1",
        "wp-phpunit/wp-phpunit": "^6.6 || ^7.0",
        "yoast/phpunit-polyfills": "^2.0 || ^3.0 || ^4.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=../../phpcs.xml.dist"
    }
}
