#: src/dashboard/components/dashboard/docs/Docs.js:203
msgid "Verify:"
msgstr ""

#: admin/js/build/chunks/tab-docs.2aff582aa4df64b0.chunk.js:2
#: src/dashboard/components/dashboard/docs/Docs.js:204
msgid "Run this in a terminal and confirm access-control-allow-origin: * appears in the response headers:"
msgstr ""

#: admin/js/build/chunks/tab-docs.2aff582aa4df64b0.chunk.js:2
#: src/dashboard/components/dashboard/docs/Docs.js:210
