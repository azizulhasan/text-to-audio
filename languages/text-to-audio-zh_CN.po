#. Plugin Name of the plugin
msgid "Text To Speech Ninja"
msgstr "Text To Speech Ninja"

#. Description of the plugin
msgid "Add functionality to WordPress site to read blogs out loud in more than 30 languages and write blogs by speech in more than 30 languages."
msgstr "为WordPress网站添加功能，可以用30多种语言朗读博客，并用30多种语言通过语音写作博客。"

#. Author of the plugin
msgid "Azizul Hasan"
msgstr "Azizul Hasan"

#. Author URI of the plugin
msgid "http://azizulhasan.com"
msgstr "http://azizulhasan.com"

