<?xml version="1.0"?>
<ruleset name="AtlasVoice">
	<description>WordPress Coding Standards for AtlasVoice.</description>

	<!--
		TTS-371: the standard is enforced on the code listed here. Code written
		before the standard was adopted is not listed yet; add a folder when it
		is rebuilt, so the list only grows.
	-->
	<file>./includes/Settings</file>
	<file>./includes/Help</file>
	<file>./includes/CLI</file>
	<file>./includes/Pronunciation</file>
	<file>./api/Admin_Ui_Controller.php</file>
	<file>./api/Route_Access.php</file>
	<file>./api/Pronunciation_Controller.php</file>
	<file>./api/Read_Along_Controller.php</file>
	<file>./api/Cloud_Account_Controller.php</file>
	<file>./api/Plans_Controller.php</file>
	<file>./includes/Account</file>
	<file>./api/Home_Controller.php</file>
	<file>./api/Cloud_Connection_Controller.php</file>
	<file>./api/Voice_Controller.php</file>
	<file>./api/Cloud_Jobs_Controller.php</file>
	<file>./api/Languages_Controller.php</file>
	<file>./api/Providers_Controller.php</file>
	<file>./api/Placement_Controller.php</file>
	<file>./api/Look_Controller.php</file>
	<file>./api/Words_Controller.php</file>
	<file>./api/AI_Notice_Controller.php</file>
	<file>./api/Embed_Controller.php</file>
	<file>./api/Where_Controller.php</file>
	<file>./api/Text_Controller.php</file>
	<file>./api/Areas_Controller.php</file>
	<file>./api/Advanced_Controller.php</file>
	<file>./api/Privacy_Controller.php</file>
	<file>./api/Versions_Controller.php</file>
	<file>./api/Health_Controller.php</file>
	<file>./includes/Site</file>
	<file>./includes/Content</file>
	<file>./includes/Voice</file>
	<file>./includes/Home</file>
	<file>./includes/Player</file>
	<file>./includes/Cloud</file>
	<file>./libs/AtlasVoice</file>
	<file>./admin/Admin_App.php</file>
	<file>./tests/phpunit</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Warnings are shown but only errors fail the build. -->
	<config name="ignore_warnings_on_exit" value="1"/>
	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- Classes are autoloaded by PSR-4, so a file is named after its class. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="text-to-audio"/>
			</property>
		</properties>
	</rule>

	<!--
		"wordpress" in lower case is the platform id the AtlasVoice service expects.
		The auto-fixer would capitalise it and change what is sent.
	-->
	<rule ref="WordPress.WP.CapitalPDangit">
		<exclude-pattern>*/libs/AtlasVoice/*</exclude-pattern>
		<exclude-pattern>*/includes/Cloud/*</exclude-pattern>
		<exclude-pattern>*/tests/phpunit/*</exclude-pattern>
	</rule>

	<!-- A test file may hold its small stand-in classes beside the test. -->
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>*/tests/phpunit/*</exclude-pattern>
	</rule>

	<!-- Tests are not shipped and read better without a doc block on every method. -->
	<rule ref="Squiz.Commenting">
		<exclude-pattern>*/tests/phpunit/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment">
		<exclude-pattern>*/tests/phpunit/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>*/tests/phpunit/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<exclude-pattern>*/tests/phpunit/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>*/tests/phpunit/*</exclude-pattern>
	</rule>
</ruleset>
