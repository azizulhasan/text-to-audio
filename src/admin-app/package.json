{
  "name": "atlasvoice-admin-app",
  "version": "0.0.0",
  "private": true,
  "description": "The AtlasVoice admin app (TTS-347). It has its own tools so the classic dashboard build (Laravel Mix, React 17) is not touched until that dashboard is removed.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "wp-scripts build src/index.js --output-path=../../build/admin-app",
    "start": "wp-scripts start src/index.js --output-path=../../build/admin-app",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style \"src/**/*.css\"",
    "test": "wp-scripts test-unit-js",
    "size": "node scripts/check-size.js"
  },
  "dependencies": {
    "@wordpress/icons": "^10.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.10",
    "@wordpress/components": "^28.13.0",
    "@wordpress/element": "^10.1.0",
    "@wordpress/hooks": "^5.1.0",
    "@wordpress/i18n": "^7.1.0",
    "@wordpress/scripts": "^30.0.0",
    "jest-axe": "^8.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.5.4"
  }
}
