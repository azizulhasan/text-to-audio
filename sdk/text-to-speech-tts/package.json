  "description": "A standalone JavaScript SDK for adding text-to-speech to any website using the browser's built-in speechSynthesis API.",
  "main": "text-to-speech-tts.min.js",
  "module": "text-to-speech-tts.esm.js",
  "browser": "text-to-speech-tts.min.js",
  "types": "index.d.ts",
  "style": "text-to-speech-tts.css",
  "files": [
    "text-to-speech-tts.min.js",
    "text-to-speech-tts.esm.js",
    "text-to-speech-tts.css",
